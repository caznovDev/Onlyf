# FreeOF API Security & Access Configuration
# Secret key for authorized programmatic API access (provided via x-api-key or Authorization: Bearer)
API_SECRET_KEY=

# Secret key required for write/ingestion operations (POST /api/v1/upload, POST/PATCH /api/v1/models)
ADMIN_API_KEY=

# Comma-separated list of additional allowed external origins (e.g. https://freeonlyfans.qzz.io)
ALLOWED_ORIGINS=https://freeonlyfans.qzz.io
